# Скопируйте в .streamlit/secrets.toml (файл в .gitignore) или задайте секреты / переменные окружения на платформе.
# Copy to .streamlit/secrets.toml (ignored by git) or set them as platform secrets / environment variables.

# Приватный репозиторий модели на Hugging Face Hub / private Hugging Face model repository
HF_REPO_ID = "<owner>/<private-model-repo>"

# Токен: fine-grained, только чтение, только этот репозиторий / read-only fine-grained token for this repository only
HF_TOKEN = "hf_..."
